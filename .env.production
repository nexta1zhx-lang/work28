NODE_ENV = 'production'
# 后端接口地址（按实际部署环境填写）
VUE_APP_BASE_API = ''

# 智能分析模拟界面开关：
#   true  = 任务需求分解下显示「任务网可视化」「事中规划」两个独立模拟页面（替换原三个模块的菜单与内容）
#   false = 显示原业务页面（作战筹划信息/数据链保障需求分析/数据链保障方案构建）
VUE_APP_MOCK_ANALYSIS = 'false'

# 智能分析数据来源（两个模拟页面的切换）：
#   mock = 本地模拟数据（默认，自绘 ECharts）
#   real = 对接真实服务接口（POST + iframe 嵌入服务端返回的 HTML 页面）
VUE_APP_ANALYSIS_SOURCE = 'mock'
# 真实服务地址（ANALYSIS_SOURCE=real 时生效）
VUE_APP_ANALYSIS_SERVER = 'http://39.101.73.142:8090'
